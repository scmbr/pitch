{
  "name": "pitch-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "prebuild:dev": "node scripts/copy-pdf-assets.mjs",
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tslib": "2.9.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
