<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="pitch.exe"
        Arguments=""
        InstallLocation="C:\Program Files\scmbr\Pitch">
    </Installer>
    <PackageInformation
        PackageName="Pitch"
        PackageDisplayName="Pitch"
        PublisherName="CN=scmbr"
        PublisherDisplayName="scmbr"
        Version="0.1.0.0"
        PackageDescription="Offline pitch practice trainer">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.scmbr.pitch"
                Description="Offline pitch practice trainer"
                DisplayName="Pitch"
                ExecutableName="pitch.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Pitch</DisplayName>
            <PublisherDisplayName>scmbr</PublisherDisplayName>
            <Description>Offline pitch practice trainer</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="pitch.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
